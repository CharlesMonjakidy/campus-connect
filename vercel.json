{
    "version": 2,
    "builds": [
        {
            "src":"campus-connect/wsgi.py",
            "user":"@vercel/python",
            "config":{ "maxLambdaSize": "15mb", "runtime": "python3.12"}
        }
    ],
    "routes": [
        {
            "src":"/(.*)",
            "src":"campus-connect/wsgi.py",
        }
    ]
}